DATABOOM_ENV=local
DATABOOM_LOG_LEVEL=INFO
DATABOOM_ARTIFACT_ROOT=artifacts
DATABOOM_DATABASE_URL=postgresql+psycopg://databoom:databoom@localhost:5432/databoom
DATABOOM_REDIS_URL=redis://localhost:6379/0
DATABOOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional. When set, run and artifact routes require X-API-Key.
DATABOOM_API_KEY=

# Optional seed account. Required for a pre-created reviewer/admin account on Render.
DATABOOM_SEED_LOGIN_ID=
DATABOOM_SEED_EMAIL=
DATABOOM_SEED_NAME=
DATABOOM_SEED_PASSWORD=
DATABOOM_ALLOW_REGISTRATION=true

# Supabase project metadata. The backend uses DATABOOM_DATABASE_URL for Postgres state.
DATABOOM_SUPABASE_URL=
DATABOOM_SUPABASE_ANON_KEY=

# Optional platform LLM key. Users can still provide a per-request key from Settings.
DATABOOM_LLM_PLATFORM_API_KEY=
DATABOOM_LLM_DEFAULT_MODEL=gpt-4.1-mini
DATABOOM_LLM_REQUEST_TOKEN_LIMIT=4000

# Vercel / Next.js public settings.
NEXT_PUBLIC_DATABOOM_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
